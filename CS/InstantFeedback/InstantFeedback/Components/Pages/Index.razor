@page "/"
@using InstantFeedback.Models
@using DevExpress.Data.ODataLinq
@implements IDisposable
@rendermode InteractiveServer

<DxGrid EditMode="GridEditMode.EditRow"
        Data="ODataSource"
        KeyFieldName="OrderId"
        ShowFilterRow="true"
        EditModelSaving="OnEditModelSaving"
        DataItemDeleting="OnDataItemDeleting">
    <Columns>
        <DxGridCommandColumn />
        <DxGridDataColumn FieldName="ShipName" />
        <DxGridDataColumn FieldName="ShipCity" />
        <DxGridDataColumn FieldName="ShipCountry" />
        <DxGridDataColumn FieldName="Freight" />
        <DxGridDataColumn FieldName="OrderDate" />
        <DxGridDataColumn FieldName="ShippedDate" />
    </Columns>
</DxGrid>

@code {
    ODataInstantFeedbackSource ODataSource { get; set; }

    protected override void OnInitialized() {
        ODataSource = new ODataInstantFeedbackSource();
        ODataSource.KeyExpression = "OrderId";
        ODataSource.GetSource += (sender, e) => e.Query = new OrdersContext().Orders;
    }

    async Task OnEditModelSaving(GridEditModelSavingEventArgs e) {
        var order = (Order)e.EditModel;
        var context = new OrdersContext();
        if(e.IsNew) {
            context.AddObject("Orders", order);
        }
        else {
            context.AttachTo("Orders", order);
            context.UpdateObject(order);
        }
        await context.SaveChangesAsync();
    }

    async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e) {
        var id = (int)e.Grid.GetDataItemValue(e.DataItem, "OrderId");
        var context = new OrdersContext();
        var order = new Order { OrderId = id };
        context.AttachTo("Orders", order);
        context.DeleteObject(order);
        await context.SaveChangesAsync();
    }

    public void Dispose() {
        ODataSource?.Dispose();
    }
}
